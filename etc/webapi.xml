<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <!-- employee -->
    <route url="/V1/employee" method="POST">
        <service class="Rasik\EmployeeManagement\Api\EmployeeRepositoryInterface" method="save"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
    <route url="/V1/employee" method="PUT">
        <service class="Rasik\EmployeeManagement\Api\EmployeeRepositoryInterface" method="save"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
    <route url="/V1/employee/:employeeId" method="GET">
        <service class="Rasik\EmployeeManagement\Api\EmployeeRepositoryInterface" method="getById"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
    <route url="/V1/employee/:employeeId" method="DELETE">
        <service class="Rasik\EmployeeManagement\Api\EmployeeRepositoryInterface" method="deleteById"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
    <route url="/V1/employees" method="GET">
        <service class="Rasik\EmployeeManagement\Api\EmployeeRepositoryInterface" method="getList"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>

</routes>